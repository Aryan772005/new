# ==============================================================================
# CRAFTCON '26 ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development or set in Vercel Project Settings
# ==============================================================================

# 1. Turso Cloud SQLite Database Credentials (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com)
# Mandatory for all paid gaming and flagship tournament entries.
RAZORPAY_KEY_ID=rzp_live_or_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_TEST_MODE=false
PAYMENT_PROVIDER=razorpay

# 3. Google Sheets Realtime Sync (Optional / Automated)
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# 4. Nodemailer / SMTP Email Confirmation (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# 5. Admin Secret Token
ADMIN_TOKEN=your_admin_secret_token_here

# 6. Local Server Port
PORT=3000
